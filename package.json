  "devDependencies": {
    "@types/fabric": "5.3.7",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  }
}
